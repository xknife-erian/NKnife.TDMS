<UserControl x:Class="NKnife.TDMSDataViewer.Views.Wizards.LevelInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NKnife.TDMSDataViewer.ViewModels.Wizards"
             xmlns:wizards="clr-namespace:NKnife.TDMSDataViewer.Views.Wizards"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance {x:Type controls:LevelInfoControlViewModel}}">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" CanVerticallyScroll="True">
            <StackPanel.Resources>
                <Style TargetType="StackPanel" x:Key="_KeyValueBox_">
                    <Setter Property="Orientation" Value="Horizontal" />
                </Style>
                <Style TargetType="TextBlock" x:Key="_Key_">
                    <Setter Property="Width" Value="150" />
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,5,5,5" />
                </Style>
                <Style TargetType="TextBox" x:Key="_Value_">
                    <Setter Property="Width" Value="260" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="TextAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="3,0" />
                    <Setter Property="Margin" Value="0,3" />
                </Style>
                <wizards:IsFileInfo2VisibilityCvt x:Key="_IsFileInfo2VisibilityCvt_" />
                <wizards:Collection2ListVisibilityCvt x:Key="_Collection2ListVisibilityCvt_" />
            </StackPanel.Resources>
            <StackPanel Style="{StaticResource _KeyValueBox_}">
                <TextBlock Style="{StaticResource _Key_}" Text="Name" />
                <TextBox Style="{StaticResource _Value_}" />
            </StackPanel>
            <StackPanel Style="{StaticResource _KeyValueBox_}">
                <TextBlock Style="{StaticResource _Key_}" Text="Description" />
                <TextBox Style="{StaticResource _Value_}" />
            </StackPanel>
            <StackPanel Style="{StaticResource _KeyValueBox_}"
                        Visibility="{Binding IsFileInfo, Converter={StaticResource _IsFileInfo2VisibilityCvt_}}">
                <TextBlock Style="{StaticResource _Key_}" Text="Title" />
                <TextBox Style="{StaticResource _Value_}" />
            </StackPanel>
            <StackPanel Style="{StaticResource _KeyValueBox_}"
                        Visibility="{Binding IsFileInfo, Converter={StaticResource _IsFileInfo2VisibilityCvt_}}">
                <TextBlock Style="{StaticResource _Key_}" Text="Author" />
                <TextBox Style="{StaticResource _Value_}" />
            </StackPanel>
            <StackPanel Margin="155,5,98,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="0.5,0,0,3">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,5,0" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="Width" Value="110" />
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="Add Property" Command="{Binding AddPropertyCommand}" />
                    <Button Content="Remove Property" Command="{Binding RemovePropertyCommand}" />
                </StackPanel>
                <ListBox
                    Visibility="{Binding ValueTuples.Count, Converter={StaticResource _Collection2ListVisibilityCvt_}}"
                    ItemsSource="{Binding ValueTuples, Mode=TwoWay}"
                    SelectedIndex="{Binding SelectValueIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Margin" Value="2,0" />
                                        <Setter Property="Height" Value="24" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="TextAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <TextBox Width="80" Text="{Binding Name, Mode=TwoWay}" />
                                <TextBox Width="156" Text="{Binding Value, Mode=TwoWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>