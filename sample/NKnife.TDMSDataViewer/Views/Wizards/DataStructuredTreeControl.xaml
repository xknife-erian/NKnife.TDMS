<UserControl x:Class="NKnife.TDMSDataViewer.Views.Wizards.DataStructuredTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wizards="clr-namespace:NKnife.TDMSDataViewer.ViewModels.Wizards"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance {x:Type wizards:DataStructuredTreeControlViewModel}}">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top">
                <ToolBar Background="Transparent" Margin="-5,0,0,0"
                         ToolBarTray.IsLocked="True">
                    <ToolBar.Resources>
                        <Style TargetType="Button" x:Key="_ToolButtonStyle_">
                            <Setter Property="BorderBrush" Value="Gray" />
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="Padding" Value="8,3" />
                        </Style>
                    </ToolBar.Resources>
                    <Button Content="Add Group" Style="{StaticResource _ToolButtonStyle_}"
                            Command="{Binding AddGroupCmd}" />
                    <Button Content="Remove Group" Style="{StaticResource _ToolButtonStyle_}"
                            Command="{Binding RemoveGroupCmd}" />
                    <Separator />
                    <Button Content="Add Channel" Style="{StaticResource _ToolButtonStyle_}"
                            Command="{Binding AddChannelCmd}" />
                    <Button Content="Remove Channel" Style="{StaticResource _ToolButtonStyle_}"
                            Command="{Binding RemoveChannelCmd}" />
                </ToolBar>
            </Border>
            <TreeView />
        </DockPanel>
    </Border>
</UserControl>