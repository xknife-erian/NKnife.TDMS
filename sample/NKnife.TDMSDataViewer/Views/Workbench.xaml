<Window x:Class="NKnife.TDMSDataViewer.Views.Workbench"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NKnife.TDMSDataViewer.Views"
        xmlns:xcad="http://schemas.xceed.com/wpf/xaml/avalondock"
        xmlns:viewModels="clr-namespace:NKnife.TDMSDataViewer.ViewModels"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        mc:Ignorable="d"
        md:DialogServiceViews.IsRegistered="True"
        WindowStartupLocation="CenterScreen"
        Background="#BBB"
        d:DataContext="{d:DesignInstance viewModels:WorkbenchViewModel}"
        d:DesignHeight="260"
        Title="NKnife TDMSDataViewer" Width="960" Height="720">
    <Window.Resources>
        <xcad:BoolToVisibilityConverter x:Key="_BoolToVisibilityConverter_" />
        <views:DocksTemplateSelector x:Key="_TemplateSelector_" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="F5" Command="{Binding CreateSampleDataFileCmd}" />
    </Window.InputBindings>
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#EEE">
                <Menu Margin="0,5" Background="#EEE">
                    <MenuItem Header="File">
                        <MenuItem Header="New..."
                                  Command="{Binding CreateDataFileCmd}" />
                        <MenuItem Header="Open..."
                                  Command="{Binding OpenDataFileCmd}" />
                        <Separator />
                        <MenuItem Header="Sample Data..."
                                  InputGestureText="F5"
                                  Command="{Binding CreateSampleDataFileCmd}" />
                        <Separator />
                        <MenuItem Header="Exit" />
                    </MenuItem>
                    <MenuItem Header="View" />
                    <MenuItem Header="Help">
                        <MenuItem Header="About..." />
                    </MenuItem>
                </Menu>
            </Border>
            <Border DockPanel.Dock="Bottom">
                <StackPanel Height="30" Background="#EEE" />
            </Border>
            <Border>
                <xcad:DockingManager x:Name="DockingManager"
                                     PreviewMouseRightButtonDown="OnPreviewMouseRightDown"
                                     Background="Transparent"
                                     ActiveContent="{Binding ActivePaneViewModel, Mode=TwoWay}"
                                     AnchorablesSource="{Binding Tools}"
                                     DocumentsSource="{Binding Documents}"
                                     LayoutItemTemplateSelector="{StaticResource _TemplateSelector_}">

                    <xcad:DockingManager.LayoutItemContainerStyleSelector>
                        <views:DocksStyleSelector>
                            <views:DocksStyleSelector.ToolPaneStyle>
                                <Style TargetType="{x:Type xcad:LayoutAnchorableItem}">
                                    <Setter Property="Title" Value="{Binding Model.Title}" />
                                    <Setter Property="CanHide" Value="{Binding Model.CanHide}" />
                                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                                    <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}" />
                                    <Setter Property="HideCommand" Value="{Binding Model.HideCommand}" />
                                    <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                                    <Setter Property="Visibility">
                                        <Setter.Value>
                                            <Binding Path="Model.IsVisible"
                                                     Converter="{StaticResource _BoolToVisibilityConverter_}"
                                                     Mode="TwoWay" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </views:DocksStyleSelector.ToolPaneStyle>
                            <views:DocksStyleSelector.DocumentPaneStyle>
                                <Style TargetType="{x:Type xcad:LayoutItem}">
                                    <Setter Property="Title" Value="{Binding Model.Title}" />
                                    <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                                </Style>
                            </views:DocksStyleSelector.DocumentPaneStyle>
                        </views:DocksStyleSelector>
                    </xcad:DockingManager.LayoutItemContainerStyleSelector>

                    <xcad:DockingManager.LayoutUpdateStrategy>
                        <views:DockLayoutInitializer />
                    </xcad:DockingManager.LayoutUpdateStrategy>

                    <xcad:LayoutRoot>
                        <xcad:LayoutPanel Orientation="Horizontal">
                            <xcad:LayoutAnchorablePane Name="ToolsPane" DockHeight="300" DockMinWidth="250" />
                            <xcad:LayoutDocumentPane />
                        </xcad:LayoutPanel>
                    </xcad:LayoutRoot>
                </xcad:DockingManager>
            </Border>
        </DockPanel>
    </Border>
</Window>