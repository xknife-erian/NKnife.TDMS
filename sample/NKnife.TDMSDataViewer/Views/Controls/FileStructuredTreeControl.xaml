<UserControl x:Class="NKnife.TDMSDataViewer.Views.FileStructuredTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NKnife.TDMSDataViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top">
                <ToolBar Background="Transparent">
                    <Button Content="Add Group"/>
                    <Button Content="Remove Group"/>
                    <Separator/>
                    <Button Content="Add Channel"/>
                    <Button Content="Remove Channel"/>
                </ToolBar>
            </Border>
            <TreeView>

            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
